# Copy to `backend/.env` and fill in. `.env` is gitignored — never commit real values.
# app/config.py reads these with env_prefix="", so the names below map 1:1 onto Settings.

# --- Database -----------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> Session
# pooler (port 5432). Not the transaction pooler on 6543: it does not support the
# prepared statements Alembic issues. Not the direct db.<ref>.supabase.co host either:
# that one is IPv6-only.
# The `+psycopg` suffix is required — pyproject pins psycopg 3, not psycopg2.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- LLM provider -------------------------------------------------------------------
# We route through agentrouter.org, which speaks the Anthropic Messages API — so the key
# below is the agentrouter key, not an Anthropic one, and only the base URL changes.
# Leave ANTHROPIC_BASE_URL unset to talk to api.anthropic.com directly instead.
ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_API_KEY=<agentrouter-key>
ANTHROPIC_MODEL=claude-opus-5

# --- Supabase client ----------------------------------------------------------------
# These four were declared here long before anything read them (Settings used
# extra="ignore"). app/auth/ reads them now.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Auth (ARCHITECTURE.md §7) ------------------------------------------------------
# Every caller must present a verified Supabase access token (Authorization: Bearer).
# Only for projects old enough to have no JWKS endpoint. This is NOT SUPABASE_SECRET_KEY
# above — that is an API bearer credential and cannot verify a signature.
SUPABASE_JWT_SECRET=
JWT_AUDIENCE=authenticated
# Dotted paths into the token. app_metadata is service-role-writable only; pointing these
# at user_metadata would let a user grant themselves tags via supabase.auth.updateUser().
RBAC_CLAIM_PATH=app_metadata.rbac_tags
ROLE_CLAIM_PATH=app_metadata.app_role
DEFAULT_RBAC_TAGS=legal-team
DEFAULT_JURISDICTION=US-NY
